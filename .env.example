# Set these as GitHub Secrets, not in this file.
# This file documents what's required for a fork to run.

# ntfy topic — pick something hard to guess (anyone with the topic name can read your alerts)
NTFY_TOPIC=my-dca-replace-this-with-random-string

# Groq API key — sign up at https://console.groq.com (free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OKX API credentials — create a READ-ONLY API key in OKX (do NOT enable trade or withdraw)
OKX_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OKX_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OKX_PASSPHRASE=your-passphrase
